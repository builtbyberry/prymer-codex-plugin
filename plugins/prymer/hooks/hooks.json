{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/lifecycle.mjs\" session-start codex; if command -v curl >/dev/null 2>&1 && ! curl -s -o /dev/null --max-time 3 'https://prymer.app/mcp/prymer' >/dev/null 2>&1; then printf '%s' 'Prymer is NOT reachable at https://prymer.app/mcp/prymer \u2014 the connection failed, so the Prymer MCP tools are unavailable this session. This is usually a local network problem, not a Prymer outage: corporate firewalls and DNS filters routinely block newly registered domains. Check whether that URL opens in a browser here, then try a different network (a phone hotspot is enough) to confirm. If it is filtered, ask your network administrator to allow the domain. Do not report a Prymer outage without first confirming it is unreachable from another network too.'; else printf '%s' 'Prymer is connected. Before starting work, call the get_context_for_injection MCP tool for the Prymer channel named by the prymer-channel marker (or an older swarm-channel marker) in this project instructions file (CLAUDE.md, AGENTS.md or similar) to load what other sessions already know. If there is no marker, ask the user which channel to use, and do not pick one from list_channels yourself.'; fi",
                        "statusMessage": "Loading Prymer context"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "mcp__(plugin_prymer_)?prymer__get_context_for_injection",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/lifecycle.mjs\" pre-tool-use codex"
                    }
                ]
            },
            {
                "matcher": "mcp__(plugin_prymer_)?prymer__gate_approve",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/gate-approve-guard.mjs\""
                    }
                ]
            },
            {
                "matcher": "^(Bash|apply_patch|Edit|Write)$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/pre-tool-save.mjs\" codex",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "mcp__(plugin_prymer_)?prymer__list_channels",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/grant-refusal-notice.mjs\""
                    }
                ]
            },
            {
                "matcher": "^(apply_patch|Edit|Write)$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/lifecycle.mjs\" post-tool-use codex"
                    }
                ]
            },
            {
                "matcher": "^mcp__(plugin_prymer_)?prymer__(get_context_for_injection|checkpoint|share_session)$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/lifecycle.mjs\" post-tool-use codex"
                    }
                ]
            },
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "input=$(cat); case \"$input\" in *gh*pr*create*) printf '%s' \"$input\" | node \"${PLUGIN_ROOT}/hooks/lifecycle.mjs\" post-tool-use codex ;; esac"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/lifecycle.mjs\" stop codex"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${PLUGIN_ROOT}/hooks/grant-refusal-notice.mjs\""
                    }
                ]
            }
        ]
    }
}
